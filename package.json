{
  "name": "hadoku-task-mobile",
  "version": "3.1.5",
  "description": "Hadoku Task Mobile - Android APK wrapper",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm exec http-server www -p 8080 -o",
    "build": "echo 'No build needed - static HTML'",
    "sync": "pnpm exec cap sync",
    "open:android": "pnpm exec cap open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:install": "cd android && ./gradlew installDebug",
    "generate-icons": "node scripts/generate-icons.js",
    "bump-version": "node scripts/bump-version.js && git add android/app/build.gradle",
    "prepare": "husky",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:html",
    "lint:js": "eslint www/**/*.js",
    "lint:css": "stylelint www/**/*.css",
    "lint:html": "htmlhint www/**/*.html",
    "lint:fix": "eslint www/**/*.js --fix && stylelint www/**/*.css --fix",
    "release": "node scripts/release.js",
    "release:patch": "pnpm version patch --no-git-tag-version && pnpm run release",
    "release:minor": "pnpm version minor --no-git-tag-version && pnpm run release",
    "release:major": "pnpm version major --no-git-tag-version && pnpm run release"
  },
  "keywords": [
    "capacitor",
    "android",
    "task-manager"
  ],
  "author": "Hadoku",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "htmlhint": "^1.7.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "sharp": "^0.34.5",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3"
  }
}
